{
  "name": "mj-bike-tangier",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "MJ Bike Tangier \u2014 multilingual bike rental, tour booking and CMS platform",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "build:only": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "cf:dev": "npm run build && wrangler pages dev dist",
    "cf:deploy": "npm run build && wrangler pages deploy dist --project-name mj-bike-tangier",
    "cf:preview": "npm run build && wrangler pages deploy dist --project-name mj-bike-tangier --branch preview",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:seed": "supabase db reset --db-url \"$SUPABASE_DB_URL\"",
    "db:types": "supabase gen types typescript --project-id \"$SUPABASE_PROJECT_ID\" --schema public > src/types/database.generated.ts",
    "seed:sql": "node scripts/generate-seed-sql.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "hono": "^4.9.0",
    "lucide-react": "^0.544.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.0",
    "recharts": "^3.1.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.35.0"
  }
}
