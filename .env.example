# =====================================================================
# MJ Bike Tangier — environment variables
#
# Copy to `.env` for local development and set the same values in
# Cloudflare Pages → Settings → Environment variables (Production + Preview).
#
# Anything prefixed VITE_ is embedded in the browser bundle: never put a
# secret there. Server-only values are read by the Pages Functions only.
# =====================================================================

# --- Public (browser) ------------------------------------------------
# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=
# Supabase anon (public) key — safe in the browser, protected by RLS
VITE_SUPABASE_ANON_KEY=
# Canonical site origin, used for SEO tags, emails and admin deep links
VITE_SITE_URL=https://mjbiketangier.com

# --- Server only (Cloudflare Pages Functions) ------------------------
# Same project URL, read by the Functions (no VITE_ prefix).
SUPABASE_URL=
# Optional anon key for server-side token verification.
SUPABASE_ANON_KEY=
# Bypasses RLS. Never expose it to the browser and never prefix it with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend) ---------------------------------------------------
# https://resend.com → API Keys. Without it, emails are logged as "skipped".
RESEND_API_KEY=
# Must be a verified sender/domain in Resend
EMAIL_FROM=MJ Bike Tangier <bookings@mjbiketangier.com>
# Where new reservation requests and contact messages are sent
ADMIN_EMAIL=contact@mjbiketangier.com

# --- Optional: WhatsApp Business Cloud API ---------------------------
# Only used when both values are present. Approve a message template first
# for business-initiated messages, otherwise delivery is logged as "skipped".
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Deployment -------------------------------------------------------
# Origin allowed by the API CORS/CSRF checks
SITE_URL=https://mjbiketangier.com
